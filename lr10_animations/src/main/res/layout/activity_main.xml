<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_autumn_fallback"
    android:paddingTop="16dp"
    tools:context=".MainActivity">

    <!-- Кастомный View для анимации -->
    <com.example.lr10_animations.WeatherView
        android:id="@+id/weatherView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Панель кнопок сверху -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnAutumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#000000"
            android:text="@string/btn_autumn" />

        <Button
            android:id="@+id/btnWinter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:shadowColor="#000000"
            android:text="@string/btn_winter" />

        <Button
            android:id="@+id/btnSummer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:shadowColor="#000000"
            android:text="@string/btn_summer" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>